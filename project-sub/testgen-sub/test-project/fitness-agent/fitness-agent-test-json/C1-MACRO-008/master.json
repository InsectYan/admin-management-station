{
  "vars": {
    "coach_id": 1,
    "user_id": 10002
  },
  "steps": [
    {
      "name": "0 · CLI 宏观计划门禁全量",
      "runner": "cli",
      "command": "cd server && npm run test:stations -- s04-macro"
    },
    {
      "name": "1 · create session",
      "runner": "http",
      "method": "POST",
      "path": "/api/sessions",
      "body": {
        "coach_id": 1,
        "user_id": 10002
      },
      "expect_status": 200,
      "extract": {
        "session_id": "$.session_id"
      }
    },
    {
      "name": "2 · submit 生成计划",
      "runner": "http",
      "method": "POST",
      "path": "/api/chat/turns/submit",
      "body": {
        "session_id": "{{session_id}}",
        "coach_id": 1,
        "user_id": 10002,
        "message": "请给张三生成训练计划",
        "client_turn_id": "{{uuid}}"
      },
      "expect_status": 202,
      "extract": {
        "turn_id": "$.turn_id"
      }
    },
    {
      "name": "3 · poll 至 plan_form/draft",
      "runner": "http",
      "method": "GET",
      "path": "/api/chat/turns/{{turn_id}}",
      "expect_status": 200
    }
  ]
}
