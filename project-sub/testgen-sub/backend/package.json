{
  "name": "testgen-sub-backend",
  "version": "1.0.0",
  "description": "Testgen sub-app BFF (Egg.js)",
  "private": true,
  "egg": {
    "declarations": false
  },
  "scripts": {
    "dev": "egg-bin dev",
    "start": "egg-scripts start --daemon --title=testgen-sub-backend",
    "stop": "egg-scripts stop --title=testgen-sub-backend",
    "smoke:e6": "node scripts/e6-smoke.js",
    "smoke:agent-linkage": "node scripts/agent-linkage-smoke.js",
    "smoke:phase-p": "node scripts/phase-p-smoke.js",
    "smoke:phase-0": "node scripts/phase-0-smoke.js",
    "smoke:n2-fixed-resolve": "node scripts/n2-fixed-resolve-smoke.js",
    "smoke:phase-1-agents": "node scripts/phase-1-agents-smoke.js",
    "smoke:phase-2-pipeline": "node scripts/phase-2-pipeline-smoke.js",
    "db:init": "node scripts/init-db.js",
    "db:sync": "node scripts/sync-schema.js",
    "db:seed": "node scripts/seed-data.js",
    "db:reset": "node scripts/db-cli.js reset",
    "db": "node scripts/db-cli.js all"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "dotenv": "^16.4.7",
    "egg": "^3.27.1",
    "egg-cors": "^3.0.1",
    "egg-scripts": "^3.0.1",
    "egg-sequelize": "^6.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4"
  },
  "devDependencies": {
    "egg-bin": "^6.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
