APP_KEY=ops
OPS_PORT=5203
PORT=5203
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5303
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ops_db
# 与 menu-master 同一值，只验 JWT，不签发
JWT_SECRET=CHANGE_ME_LOCAL_JWT
# 主应用地址，部署执行器按用户名读取 GitHub Token
MENU_MASTER_URL=http://127.0.0.1:5200
# 与 menu-master 的 OPS_INTERNAL_KEY / JWT_SECRET 相同
OPS_INTERNAL_KEY=CHANGE_ME_LOCAL_JWT
# 本地无登录调试才开；默认必须带 Bearer
# OPS_AUTH_OPTIONAL=1
# 部署：OPS_DEPLOY_MOCK=1 强制假日志；=0 强制真跑；不设则 AgentRun 与显式 local/github 都走真 runner
# OPS_DEPLOY_MOCK=
# OPS_DEPLOY_WORKDIR=
# OPS_DEPLOY_BUILD_TIMEOUT_MS=900000
# OPS_DEPLOY_SKILL=ops-deploy-skill
# OPS_GIT_TOKEN=
# OPS_GITEE_TOKEN=

# Agent 平台（生成配置文件）
AGENT_PLATFORM_URL=http://127.0.0.1:4001
AGENT_PLATFORM_TIMEOUT_MS=600000
OPS_PROJECT_SKILL=ops-project-skill
