APP_KEY=ops
OPS_PORT=5203
PORT=5203
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5303
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ops_db
# 与 menu-master 同一值，只验 JWT，不签发
JWT_SECRET=CHANGE_ME_LOCAL_JWT
# 主应用地址，部署执行器按用户名读取 GitHub Token
MENU_MASTER_URL=http://127.0.0.1:5200
# 与 menu-master 的 OPS_INTERNAL_KEY / JWT_SECRET 相同
OPS_INTERNAL_KEY=CHANGE_ME_LOCAL_JWT
# 本地无登录调试才开；默认必须带 Bearer
# OPS_AUTH_OPTIONAL=1
# 部署：OPS_DEPLOY_MOCK=1 强制假日志；=0 强制真跑；不设则 AgentRun 与显式 local/github 都走真 runner
# OPS_DEPLOY_MOCK=
# OPS_DEPLOY_EXECUTOR=auto
# OPS_DEPLOY_WORKDIR=/tmp/ops-deploy
# 宿主机绝对路径，与容器 OPS_DEPLOY_WORKDIR 同一目录（Docker Desktop 宿主机执行器必需）
# OPS_DEPLOY_WORKDIR_HOST=
# OPS_DEPLOY_BUILD_TIMEOUT_MS=900000
# AgentRun 整段超时默认 45 分钟；失败先看执行面/OSS 预检，勿只靠加大该值
# OPS_DEPLOY_AGENTRUN_TIMEOUT_MS=2700000
# OPS_DEPLOY_OSS_MIN_MBPS=1
# 宿主机执行器（ams-ops local 自动起 :1329；容器 FC TLS 失败时走此路径，等同 fitness-cli）
# OPS_HOST_RUNNER_HOST=host.docker.internal
# OPS_HOST_RUNNER_PORT=1329
# 旧 CONNECT 代理默认关；仅排障时 OPS_HOST_EGRESS_ENABLED=1
# OPS_HOST_EGRESS_ENABLED=0
# OPS_HOST_EGRESS_PORT=1328
# OPS_HOST_EGRESS_HOST=host.docker.internal
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# 无新日志时心跳间隔（毫秒）
# OPS_DEPLOY_HEARTBEAT_MS=20000
# OPS_DEPLOY_SKILL=ops-deploy-skill
# OPS_GIT_TOKEN=
# OPS_GITEE_TOKEN=

# Agent 平台（生成配置文件）
AGENT_PLATFORM_URL=http://127.0.0.1:4001
AGENT_PLATFORM_TIMEOUT_MS=600000
OPS_PROJECT_SKILL=ops-project-skill
