# 复制为 .env.local 后按需修改（或直接改仓库内已提交的 .env.local）
# 路径一律优先用「相对 deploy/」的写法，保证 Linux / ECS 可 docker compose up

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ops_db

OPS_PORT=5203
OPS_POSTGRES_DB=ops_db
OPS_VITE_PORT=5103
OPS_POSTGRES_PORT=5303

JWT_SECRET=CHANGE_ME_LOCAL_JWT
CACHE_DRIVER=memory
MENU_MASTER_URL=http://host.docker.internal:5200
OPS_INTERNAL_KEY=CHANGE_ME_LOCAL_JWT

POSTGRES_IMAGE=postgres:16-alpine
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

AGENT_PLATFORM_URL=http://host.docker.internal:4001
AGENT_PLATFORM_TIMEOUT_MS=600000
OPS_PROJECT_SKILL=ops-project-skill

HOST_PROJECTS_ROOT=/host-projects
# 相对 deploy/ → monorepo 根。Windows 扩展挂载示例：E:/AI Tools/projects
HOST_PROJECTS_MOUNT=../../..

OPS_DEPLOY_EXECUTOR=auto
OPS_DEPLOY_WORKDIR=/tmp/ops-deploy
OPS_DEPLOY_WORKDIR_HOST=../.ops-deploy-work
OPS_HOST_RUNNER_HOST=host.docker.internal
OPS_HOST_RUNNER_PORT=1329
OPS_HOST_EGRESS_ENABLED=0
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# —— ECS GitHub 镜像（本地保持 0，勿改本机行为）——
# AMS 与业务仓同级，例如：
#   /opt/project/admin-management-station
#   /opt/project/fitness-agent
# ECS 必须让容器看到同一路径（MOUNT 与 ROOT 都写 /opt/project）：
#   OPS_GIT_MIRROR_ENABLED=1
#   OPS_GIT_MIRROR_MOUNT=/opt/project
#   OPS_GIT_MIRROR_ROOT=/opt/project
# 错误：ROOT=/host-mirrors 而 MOUNT=/opt/project → 容器 /opt/project 不是宿主机工程
OPS_GIT_MIRROR_ENABLED=0
OPS_GIT_MIRROR_MOUNT=../.ops-git-mirrors
OPS_GIT_MIRROR_ROOT=/host-mirrors

# —— GitHub SSH（部署页选 SSH 时需要）——
# 宿主机目录挂到容器 /ops-git-ssh，内放私钥 id_ed25519（或 id_rsa），并把公钥加到仓库 Deploy keys
# ECS 示例：OPS_GIT_SSH_MOUNT=/opt/project/.ops-git-ssh
# 可选：OPS_GIT_SSH_KEY=/ops-git-ssh/id_ed25519
# known_hosts 默认用镜像内置 /etc/ssh/github_known_hosts
OPS_GIT_SSH_MOUNT=../.ops-git-ssh
OPS_GIT_SSH_DIR=/ops-git-ssh
OPS_GIT_SSH_KNOWN_HOSTS=/etc/ssh/github_known_hosts
