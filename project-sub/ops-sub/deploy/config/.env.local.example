# 复制为 .env.local 后按需修改（或直接改仓库内已提交的 .env.local）
# 路径一律优先用「相对 deploy/」的写法，保证 Linux / ECS 可 docker compose up

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ops_db

OPS_PORT=5203
OPS_POSTGRES_DB=ops_db
OPS_VITE_PORT=5103
OPS_POSTGRES_PORT=5303

JWT_SECRET=CHANGE_ME_LOCAL_JWT
CACHE_DRIVER=memory
MENU_MASTER_URL=http://host.docker.internal:5200
OPS_INTERNAL_KEY=CHANGE_ME_LOCAL_JWT

POSTGRES_IMAGE=postgres:16-alpine
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

AGENT_PLATFORM_URL=http://host.docker.internal:4001
AGENT_PLATFORM_TIMEOUT_MS=600000
OPS_PROJECT_SKILL=ops-project-skill

HOST_PROJECTS_ROOT=/host-projects
# 相对 deploy/ → monorepo 根。Windows 扩展挂载示例：E:/AI Tools/projects
HOST_PROJECTS_MOUNT=../../..

OPS_DEPLOY_EXECUTOR=auto
OPS_DEPLOY_WORKDIR=/tmp/ops-deploy
OPS_DEPLOY_WORKDIR_HOST=../.ops-deploy-work
OPS_HOST_RUNNER_HOST=host.docker.internal
OPS_HOST_RUNNER_PORT=1329
OPS_HOST_EGRESS_ENABLED=0
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
