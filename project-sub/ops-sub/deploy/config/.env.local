# 运维子应用本地 Docker 默认
# 端口注册：docs-project/应用端口与命名注册表.md

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ops_db

OPS_PORT=5203
OPS_POSTGRES_DB=ops_db
OPS_VITE_PORT=5103
OPS_POSTGRES_PORT=5303

JWT_SECRET=CHANGE_ME_LOCAL_JWT
CACHE_DRIVER=memory
MENU_MASTER_URL=http://host.docker.internal:5200
OPS_INTERNAL_KEY=CHANGE_ME_LOCAL_JWT

# 国内无法直连 Docker Hub 时使用镜像加速
POSTGRES_IMAGE=docker.1ms.run/library/postgres:16-alpine
# 构建 api-ops 时装 git：Alpine 官方 CDN 不通时换源
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

# 宿主机 Agent 平台（容器内用 host.docker.internal）
AGENT_PLATFORM_URL=http://host.docker.internal:4001
AGENT_PLATFORM_TIMEOUT_MS=600000
OPS_PROJECT_SKILL=ops-project-skill

# AgentRun 从 source_path 部署时，把宿主机项目根挂进容器
HOST_PROJECTS_ROOT=/host-projects
HOST_PROJECTS_MOUNT=E:/AI Tools/projects
